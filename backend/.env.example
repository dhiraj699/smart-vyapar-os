NODE_ENV=production
PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/smart_vyapar?retryWrites=true&w=majority
CORS_ORIGIN=https://your-vyapar-app.vercel.app,http://localhost:5173
LOG_LEVEL=info
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# Default Accounts & Credentials (change these in your local .env)
ADMIN_NAME=Store Owner
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_admin_password
ADMIN_PHONE=9876543210

STAFF_NAME=Counter Cashier
STAFF_USERNAME=staff
STAFF_PASSWORD=your_secure_staff_password
STAFF_PHONE=9876543211

DEALER_NAME=Vendor Partner
DEALER_AGENCY=Wholesale Supplier
DEALER_USERNAME=dealer
DEALER_PASSWORD=your_secure_dealer_password
DEALER_PHONE=9876543212

# Shop identity & Official NPCI UPI ID
SHOP_NAME=Smart Vyapar Kirana
SHOP_ADDRESS=Store Address, City, State - PIN
SHOP_PHONE=9876543210
SHOP_UPI_ID=merchant@upi

# Analytics defaults
DEAD_STOCK_DAYS=45

# Optional LLM integration for AI Assistant
GEMINI_API_KEY=
OPENAI_API_KEY=
